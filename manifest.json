--- pak-map-app/manifest.json (原始)


+++ pak-map-app/manifest.json (修改后)
{
  "name": "PAK MAP - Pakistan National Navigation",
  "short_name": "PAK MAP",
  "description": "Privacy-focused national map application for Pakistan with offline support, satellite imagery, and bilingual navigation",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#115740",
  "theme_color": "#115740",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["navigation", "maps", "travel"],
  "lang": "en",
  "dir": "ltr"
}
